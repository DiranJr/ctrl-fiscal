# CTRL Fiscal — somente na VPS (deploy/compose.prod.yaml). Processado pelo envsubst da imagem nginx e incluído no
# contexto http, antes do default.conf do gateway.
#
# Na VPS, o Nginx do host termina o HTTPS e conecta em 127.0.0.1:${HTTP_PORT}; essa conexão chega ao gateway vinda
# do endereço do gateway da rede Docker "publico" (TRUSTED_PROXY_IP = 10.250.250.1). Sem isto, os limites
# "limit_req" (por $binary_remote_addr) e o X-Real-IP repassado ao core-api (limite de tentativas de login por IP)
# tratariam TODOS os usuários como um único IP. O Nginx do host SOBRESCREVE X-Forwarded-For com o IP real (o
# cliente não consegue forjá-lo); o gateway só aceita esse cabeçalho, e o X-Forwarded-Proto (map $ctrl_proto em
# infra/gateway/default.conf.template), quando a conexão vem de TRUSTED_PROXY_IP.
set_real_ip_from ${TRUSTED_PROXY_IP};
real_ip_header X-Forwarded-For;
real_ip_recursive off;
