# =============================================================================================================
# CTRL Fiscal — configuração da VPS (NÃO secreta). Copie para a RAIZ do repositório como ".env":
#   cp deploy/env.producao.exemplo .env && chmod 600 .env
# Valores marcados TROQUE-ME precisam ser ajustados. Segredos NÃO entram aqui: são arquivos em SECRETS_DIR,
# gerados/importados por deploy/gerar-segredos.sh.
# =============================================================================================================

# ---- Versão implantada: SHA curto do commit (git rev-parse --short=12 HEAD). Gravado por deploy/implantar.sh.
# Vazio até a primeira implantação.
VERSAO=

# ---- AMBIENTE ATIVO -----------------------------------------------------------------------------------------
# Só UM ambiente pode ter o fiscal-worker ligado (VPS OU instalação local): sincronização ADN, filas de emissão e
# cancelamento, importações, exportações e limpezas.
#   ambiente em espera: COMPOSE_PROFILES=          (vazio: sem worker)
#   ambiente ativo:     COMPOSE_PROFILES=ativo
# Antes de ativar a VPS, PARE o worker local:  docker compose -p ctrlfiscal stop fiscal-worker  (no Windows).
COMPOSE_PROFILES=

# ---- Domínio público (HTTPS terminado pelo Nginx do HOST, com certificado do Certbot) ----------------------
DOMINIO=fiscal.grupoaelengenharia.com.br
# Porta do gateway publicada SOMENTE em 127.0.0.1; o Nginx do host faz proxy_pass para ela.
# Precisa estar livre (ss -ltnH) e NUNCA ser 3001 (usada por outro sistema). Ajuste também deploy/nginx/*.conf.
HTTP_PORT=8088
# Rede Docker exclusiva do gateway e o endereço do gateway dessa bridge, de onde chegam as conexões do Nginx do
# host. Só esse endereço pode informar X-Forwarded-For/X-Forwarded-Proto. Troque os dois juntos se colidirem
# com alguma rede existente (deploy/inventario-vps.sh lista as sub-redes).
PROXY_SUBNET=10.250.250.0/28
TRUSTED_PROXY_IP=10.250.250.1

# ---- Aplicação ----------------------------------------------------------------------------------------------
# APP_ENV é forçado para "production" em deploy/compose.prod.yaml: origem HTTPS e cookie Secure obrigatórios.
APP_ENV=production
LOG_LEVEL=INFO
ENABLE_API_DOCS=false
# ALLOWED_ORIGINS é derivado de DOMINIO (https://${DOMINIO}) em deploy/compose.prod.yaml; cookie sempre Secure.
ALLOWED_ORIGINS=https://fiscal.grupoaelengenharia.com.br
ALLOW_INSECURE_DEV_COOKIE=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
UPLOAD_MAX_BYTES=26214400

# ---- Pool de conexões ao MySQL por serviço (cabe com folga em max_connections=120) ---------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ---- Worker (ambiente ativo): valores conservadores para VPS compartilhada --------------------------------------
EMISSION_MAX_IN_FLIGHT=5
EMISSION_BATCH_SIZE=5
SYNC_MAX_PAGES_PER_CYCLE=10
DPS_SERIES=1

# ---- Segredos (arquivos). Pasta FORA do repositório, dono root, modo 700 ------------------------------------
SECRETS_DIR=/opt/ctrlfiscal/segredos

# ---- Integração com o Sistema Nacional da NFS-e ---------------------------------------------------------------
# Emissão em Produção Restrita (homologação): desligada.
NFSE_RESTRICTED_ENABLED=false
# Produção: leitura da distribuição ADN. A EMISSÃO em produção continua BLOQUEADA no código.
NFSE_PRODUCTION_DISTRIBUTION_ENABLED=true
# Cancelamento em produção (eventos 101101/101103): habilitado pelo titular; cada pedido exige confirmação
# individual de um usuário com a permissão "cancel".
NFSE_PRODUCTION_CANCELLATION_ENABLED=true
# Governo simulado: somente testes automatizados. Nunca true em produção.
NFSE_MOCK_ENABLED=false
NFSE_MOCK_PAGE_SIZE=3

# ---- DANFSe: fontes licenciadas opcionais (ver deploy/compose.prod.yaml). Vazio = Liberation Sans ----------
DANFSE_FONT_DIR=

# ---- Backup (deploy/backup-criptografado.sh) ----------------------------------------------------------------
# Destino local dos backups CIFRADOS (copie também para fora da VPS).
BACKUP_DIR=/opt/ctrlfiscal/backups
# Chave PÚBLICA do age (destinatário). A chave PRIVADA fica FORA da VPS (cofre do titular).
BACKUP_AGE_RECIPIENT=age1TROQUE-ME
# Alternativa: chave pública GPG já importada no chaveiro do root (deixe BACKUP_AGE_RECIPIENT vazio).
BACKUP_GPG_RECIPIENT=
# Quantos dias manter backups locais.
BACKUP_RETENCAO_DIAS=30
