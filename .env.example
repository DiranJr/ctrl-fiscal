# CTRL Fiscal — configuração NÃO secreta da instalação LOCAL (Windows/Docker Desktop ou Linux de desenvolvimento).
# Copie para .env (scripts/gerar-segredos.ps1 faz isso no Windows). Segredos NUNCA ficam aqui: são arquivos em
# ./secrets (scripts/gerar-segredos.ps1 no Windows; deploy/gerar-segredos.sh no Linux).
# Para a VPS use deploy/env.producao.exemplo.

# Porta do gateway publicada SOMENTE em 127.0.0.1.
HTTP_PORT=8088
# development | test | production (production exige HTTPS nas origens e cookie Secure).
APP_ENV=development
LOG_LEVEL=INFO
# Origens aceitas pelo CSRF/CORS do core-api (separadas por vírgula).
ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
# Somente desenvolvimento HTTP local. Produção (APP_ENV=production) recusa iniciar com cookie sem Secure.
ALLOW_INSECURE_DEV_COOKIE=true
# Swagger/ReDoc das APIs; proibido em produção.
ENABLE_API_DOCS=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Limite de upload de importação (bytes).
UPLOAD_MAX_BYTES=26214400

# Proxy HTTPS confiável na frente do gateway: 0.0.0.0 = nenhum (instalação local acessada direto em HTTP).
TRUSTED_PROXY_IP=0.0.0.0

# Tag das imagens locais ctrlfiscal/<serviço>:<IMAGE_TAG>.
IMAGE_TAG=dev
# Pasta dos arquivos de segredo (padrão ./secrets).
SECRETS_DIR=./secrets

# Emissão oficial em Produção Restrita (homologação do Sistema Nacional). Desligada por padrão.
NFSE_RESTRICTED_ENABLED=false
# Produção: SOMENTE leitura da distribuição ADN; emissão em produção é bloqueada em código.
NFSE_PRODUCTION_DISTRIBUTION_ENABLED=true
# Cancelamento em produção (eventos 101101/101103): habilitado pelo titular; cada pedido exige confirmação
# individual de um usuário com a permissão "cancel". Emissão em produção continua bloqueada no código.
NFSE_PRODUCTION_CANCELLATION_ENABLED=true
# Mock desligado em execução (sem fallback); os testes automatizados ligam o mock por conta própria.
NFSE_MOCK_ENABLED=false
NFSE_MOCK_PAGE_SIZE=3
EMISSION_MAX_IN_FLIGHT=10
DPS_SERIES=1

# Fontes licenciadas do DANFSe (arial.ttf, arialbd.ttf, micross.ttf) num diretório montado somente leitura.
# Vazio = Liberation Sans (substituta livre já incluída na imagem; o desvio é declarado no PDF).
DANFSE_FONT_DIR=

# ---- Somente na VPS (deploy/env.producao.exemplo traz o arquivo completo; não use estes valores localmente) ----
# DOMINIO=fiscal.grupoaelengenharia.com.br
# APP_ENV=production
# ALLOWED_ORIGINS=https://fiscal.grupoaelengenharia.com.br
# ALLOW_INSECURE_DEV_COOKIE=false
# TRUSTED_PROXY_IP=10.250.250.1
# VERSAO=<sha curto do commit>
# COMPOSE_PROFILES=          (espera)  |  COMPOSE_PROFILES=ativo  (único ambiente com worker)
# DB_POOL_SIZE=5  DB_MAX_OVERFLOW=5  DB_POOL_TIMEOUT=30
